import requests
from bs4 import BeautifulSoup
import json
from urllib.parse import urljoin
# As páginas do PROFBIO que contêm os PDFs
PAGINAS_ALVO = [
"https://sistemaprofbio.icb.ufmg.br/pub/reg.php",
"https://sistemaprofbio.icb.ufmg.br/pub/portarias.php",
"https://sistemaprofbio.icb.ufmg.br/pub/normasforms.php",
"https://sistemaprofbio.icb.ufmg.br/pub/tutoriais.php"
]
dicionario_links = {}
print("🔍 Iniciando a varredura (Web Scraping) no site do PROFBIO...")
for pagina in PAGINAS_ALVO:
print(f"Acessando: {pagina}")
try:
resposta = requests.get(pagina)
resposta.raise_for_status()
sopa = BeautifulSoup(resposta.text, 'html.parser')
links = sopa.find_all('a')
for link in links:
href = link.get('href')
# ⚡ A MUDANÇA ESTÁ AQUI: Aceita .pdf, .doc e .docx
if href and href.lower().endswith(('.pdf', '.doc', '.docx')):
url_completa = urljoin(pagina, href)
nome_arquivo = url_completa.split('/')[-1]
dicionario_links[nome_arquivo] = url_completa
except Exception as e:
print(f"⚠️ Erro ao processar {pagina}: {e}")
with open("links_profbio.json", "w", encoding="utf-8") as f:
json.dump(dicionario_links, f, indent=4, ensure_ascii=False)
print(f"\n✅ Scraping concluído! {len(dicionario_links)} arquivos mapeados com sucesso.")
