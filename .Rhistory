import os
from dotenv import load_dotenv
from llama_index.core import VectorStoreIndex, SimpleDirectoryReader, Settings
from llama_index.llms.openai import OpenAI
from llama_index.embeddings.jinaai import JinaEmbedding
# Carregar as chaves do ficheiro .env
load_dotenv()
# 1. Configurar o LLM (OpenRouter)
Settings.llm = OpenAI(
model="meta-llama/llama-3.1-8b-instruct:free", # Modelo gratuito e rápido para testes
api_key=os.environ.get("OPENROUTER_API_KEY"),
api_base="https://openrouter.ai/api/v1",
is_chat_model=True
)
# 2. Configurar o Motor de Vetorização (Jina AI)
Settings.embed_model = JinaEmbedding(
api_key=os.environ.get("JINA_API_KEY"),
model="jina-embeddings-v2-base-en"
)
def iniciar_assistente():
print("📚 A ler os PDFs do PROFBIO...")
# Lê todos os PDFs dentro da pasta
documentos = SimpleDirectoryReader("base_profbio").load_data()
print("🧠 A processar e vetorizar o conhecimento...")
# Cria a base de dados vetorial em memória
index = VectorStoreIndex.from_documents(documentos)
print("✅ Base pronta! Digite 'sair' para terminar.\n")
# Inicia o motor de chat
chat_engine = index.as_chat_engine(chat_mode="condense_question")
while True:
pergunta = input("👤 Você: ")
if pergunta.lower() in ["sair", "exit", "quit"]:
break
# O agente procura no PDF e formula a resposta
resposta = chat_engine.chat(pergunta)
print(f"\n🤖 Assistente PROFBIO: {resposta}\n")
print("-" * 50)
if __name__ == "__main__":
iniciar_assistente()
if __name__ == "__main__":
iniciar_assistente()
import os
import time
from dotenv import load_dotenv
from llama_index.core import (
VectorStoreIndex,
SimpleDirectoryReader,
Settings,
StorageContext,
load_index_from_storage
)
from llama_index.llms.openai_like import OpenAILike
from llama_index.embeddings.huggingface import HuggingFaceEmbedding
from llama_index.core.node_parser import SentenceSplitter
load_dotenv()
# 1. Configurar o LLM (OpenRouter)
Settings.llm = OpenAILike(
model="meta-llama/llama-3.1-8b-instruct:free",
api_key=os.environ.get("OPENROUTER_API_KEY"),
api_base="https://openrouter.ai/api/v1",
is_chat_model=True,
context_window=8192,
max_tokens=2048
)
# 2. Configurar o Motor de Vetorização (Hugging Face Local - 100% Gratuito)
Settings.embed_model = HuggingFaceEmbedding(
model_name="BAAI/bge-m3"
)
# Reduz o tamanho do lote enviado de cada vez para respeitar o limite da Jina
Settings.embed_batch_size = 16
PASTA_DADOS = "base_profbio"
PASTA_BANCO = "banco_vetores"
def inicializar_banco():
if not os.path.exists(PASTA_BANCO):
print("📚 Primeira vez: A descarregar o modelo BGE-M3 e a ler PDFs localmente...")
documentos = SimpleDirectoryReader(PASTA_DADOS).load_data()
print(f"🚀 A vetorizar {len(documentos)} páginas usando o hardware local. Sem limites!")
# O show_progress=True mostra uma barra de carregamento no terminal
index = VectorStoreIndex.from_documents(documentos, show_progress=True)
print("💾 A guardar o banco de dados no disco (PASTA_BANCO)...")
index.storage_context.persist(persist_dir=PASTA_BANCO)
return index
else:
print("⚡ Banco de dados local encontrado! A carregar do disco instantaneamente...")
storage_context = StorageContext.from_defaults(persist_dir=PASTA_BANCO)
index = load_index_from_storage(storage_context)
return index
def iniciar_assistente():
# Carrega ou cria o banco
index = inicializar_banco()
# 1. Instrução de Sistema para forçar a citação no texto
prompt_sistema = (
"Você é o assistente virtual acadêmico do PROFBIO. "
"Sua função é responder dúvidas de alunos e professores baseando-se EXCLUSIVAMENTE no contexto fornecido. "
"REGRA CRÍTICA: Você DEVE citar explicitamente o nome da Portaria, Regimento, Resolução ou Norma ao longo do seu texto explicativo. "
"Se a resposta não estiver nos documentos, diga claramente: 'Não encontrei essa informação nos regimentos atuais'."
)
print("✅ Base pronta! Digite 'sair' para terminar.\n")
# Adicionamos o system_prompt ao motor do chat
chat_engine = index.as_chat_engine(
chat_mode="condense_question",
system_prompt=prompt_sistema
)
while True:
pergunta = input("👤 Você: ")
if pergunta.lower() in ["sair", "exit", "quit"]:
break
# O agente procura no PDF e formula a resposta
resposta = chat_engine.chat(pergunta)
# Imprime a resposta gerada pela IA
print(f"\n🤖 Assistente PROFBIO: {resposta}\n")
# 2. Extração das "Referências Bibliográficas" reais (Metadados)
print("📑 REFERÊNCIAS CONSULTADAS:")
fontes_citadas = set() # Usamos 'set' para não imprimir documentos duplicados
# Percorre todos os fragmentos de texto que a IA usou para formular a resposta
for node in resposta.source_nodes:
arquivo = node.metadata.get('file_name', 'Documento desconhecido')
pagina = node.metadata.get('page_label', 'Página não identificada')
# Formata a referência
referencia = f"- {arquivo} (Página {pagina})"
fontes_citadas.add(referencia)
# Imprime a lista final de fontes
for fonte in fontes_citadas:
print(fonte)
print("\n" + "-" * 50)
if __name__ == "__main__":
iniciar_assistente()
reticulate::repl_python()
